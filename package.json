{
  "name": "sticky-notes-local-first",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:cloud": "node scripts/check-cloud.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:cloud:browser": "node scripts/test-cloud.mjs --browser",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test -c playwright.prod.config.ts",
    "test:pwa-upgrade": "node scripts/check-pwa-upgrade.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^4.0.0",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "supabase": "2.118.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
